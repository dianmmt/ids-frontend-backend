# Database Configuration
DB_USER=sdn_user
DB_HOST=localhost
DB_NAME=sdn_ids
DB_PASSWORD=sdn_password
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# Server Configuration
PORT=3001
# CORS Configuration
CORS_ORIGIN=http://192.168.163.156:5173,http://192.168.163.156:5174,http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# File: backend/.env.example

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000


# Backend
PORT=3001

# Ryu controller (REST is required; WS is optional)
RYU_HOST=192.168.163.156
RYU_PORT=8080
RYU_WS_PORT=8080   # Only if you provide a WS bridge at /ws/controller

# CICFlowMeter ingestion (choose one mode)
# File watch mode:
  # or /var/log/flows.csv on Linux
# Directory where CICFlowMeter saves files
CICFLOWMETER_CSV_DIRECTORY=/home/diepanh/Desktop/CICFlowMeterdaily/
# backend/.env

# Pattern to match your files
CICFLOWMETER_CSV_PATTERN=*_Flow.csv
# Socket mode (backend opens a TCP server here):
CICFLOWMETER_SOCKET_HOST=0.0.0.0
CICFLOWMETER_SOCKET_PORT=9999

# Performance Monitoring Configuration
PERFORMANCE_COLLECTION_INTERVAL=30000
PERFORMANCE_HISTORY_RETENTION_DAYS=30
ALERT_CHECK_INTERVAL=60000

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Security Configuration
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ML Processing Configuration (if applicable)
ML_MODEL_PATH=models/
ML_BATCH_SIZE=100
ML_INFERENCE_TIMEOUT=5000

# Network Monitoring Configuration
NETWORK_INTERFACE=eth0
NETWORK_MONITORING_INTERVAL=60000

